{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "客服质检最终结果（Schema不证明语义正确）",
  "type": "object",
  "required": [
    "schema_version",
    "ticket_id",
    "category",
    "category_valid",
    "category_confidence",
    "category_evidence",
    "summary",
    "checks",
    "qc_status",
    "needs_review",
    "review_reasons",
    "route",
    "suggested_route",
    "action",
    "validation",
    "semantic_review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "ticket_id": {
      "type": "string"
    },
    "category": {
      "enum": [
        "物流配送",
        "退款退货",
        "商品质量",
        "订单与支付",
        "其他问题"
      ]
    },
    "category_valid": {
      "type": "boolean"
    },
    "category_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "category_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "message_index",
          "quote"
        ],
        "properties": {
          "message_index": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "status",
          "rule_quote",
          "reason",
          "evidence"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "R01",
              "R02",
              "R03"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "rule_quote": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "message_index",
                "quote"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "qc_status": {
      "enum": [
        "pass",
        "violation",
        "undetermined"
      ]
    },
    "needs_review": {
      "type": "boolean"
    },
    "review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "route": {
      "enum": [
        "物流客服",
        "售后客服",
        "商品售后",
        "订单客服",
        "综合客服",
        "人工复核队列"
      ]
    },
    "suggested_route": {
      "enum": [
        "物流客服",
        "售后客服",
        "商品售后",
        "订单客服",
        "综合客服"
      ]
    },
    "action": {
      "const": "suggest_only"
    },
    "validation": {
      "enum": [
        "code_checked",
        "fallback"
      ]
    },
    "semantic_review": {
      "enum": [
        "model_judgement_not_human_verified",
        "not_evaluated"
      ]
    }
  },
  "additionalProperties": false
}
